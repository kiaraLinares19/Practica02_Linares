@using Practica2.Models
@model Visita

@{
    ViewData["Title"] = "Agendar Visita";
}

<h2>Agendar Visita para: @Model.Inmueble.Titulo</h2>
<p class="text-info">Recuerda: Solo se permiten visitas de 08:00 a 19:00. Las fechas deben ser futuras.</p>

<hr />
<div class="row">
    <div class="col-md-6">
        <form asp-action="Agendar">
            @* Muestra mensajes de error generales (horario, solapamiento) [cite: 49] *@
            <div asp-validation-summary="All" class="text-danger"></div>
            
            @* Campo oculto para el ID del inmueble *@
            <input type="hidden" asp-for="InmuebleId" /> 

            <div class="form-group mb-3">
                <label asp-for="FechaInicio" class="control-label"></label>
                @* Usa datetime-local para la entrada de fecha y hora *@
                <input asp-for="FechaInicio" type="datetime-local" class="form-control" />
                <span asp-validation-for="FechaInicio" class="text-danger"></span>
            </div>
            
            <div class="form-group mb-3">
                <label asp-for="FechaFin" class="control-label"></label>
                <input asp-for="FechaFin" type="datetime-local" class="form-control" />
                <span asp-validation-for="FechaFin" class="text-danger"></span>
            </div>
            
            <div class="form-group mb-3">
                <label asp-for="Notas" class="control-label"></label>
                <textarea asp-for="Notas" class="form-control"></textarea>
                <span asp-validation-for="Notas" class="text-danger"></span>
            </div>
            
            <div class="form-group">
                <button type="submit" class="btn btn-primary">Solicitar Visita</button>
                <a asp-action="Detalle" asp-controller="Inmuebles" asp-route-id="@Model.InmuebleId" class="btn btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}