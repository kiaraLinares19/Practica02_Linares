@using Practica2.Models
@model Inmueble

@{
    ViewData["Title"] = @Model.Titulo;
   
    var reservaActiva = (bool)ViewBag.ReservaActiva;
    var fechaExpiracion = (DateTime?)ViewBag.FechaExpiracion;
}

<h2>@Model.Titulo</h2>
<p class="text-secondary">Código: @Model.Codigo | @Model.Ciudad</p>

@* --- Feedback de Reserva/Visita (Pregunta 3) --- *@
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success mt-3">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger mt-3">@TempData["ErrorMessage"]</div>
}


<div class="row">
    <div class="col-md-7">
        {{-- Asume que tienes un campo Imagen en tu modelo Inmueble --}}
        <img src="/images/@Model.Imagen" class="img-fluid rounded shadow" alt="@Model.Titulo" />

        <h4 class="mt-4">Descripción y Detalles</h4>
        <dl class="row">
            <dt class="col-sm-4">Tipo:</dt>
            <dd class="col-sm-8">@Model.Tipo</dd>

            <dt class="col-sm-4">Dirección:</dt>
            <dd class="col-sm-8">@Model.Direccion</dd>

            <dt class="col-sm-4">Dormitorios:</dt>
            <dd class="col-sm-8">@Model.Dormitorios</dd>

            <dt class="col-sm-4">Baños:</dt>
            <dd class="col-sm-8">@Model.Banos</dd>

            <dt class="col-sm-4">Metros Cuadrados:</dt>
            <dd class="col-sm-8">@Model.MetrosCuadrados.ToString("N0") m²</dd>
        </dl>
    </div>

    <div class="col-md-5">
        <div class="card bg-light shadow-sm p-4">
            <h3 class="text-primary">Precio: @Model.Precio.ToString("C0")</h3>
            <hr />

            <h4 class="mb-3">Opciones de Cliente</h4>

        
            @if (User.Identity.IsAuthenticated)
            {
                
                <a asp-controller="Visitas" asp-action="Agendar" asp-route-inmuebleId="@Model.Id" class="btn btn-success btn-lg mb-3">
                    Agendar Visita
                </a>

          
                @if (reservaActiva)
                {
              
                    <div class="alert alert-warning">
                        Este inmueble está **RESERVADO** por un cliente. <br />
                        Bloqueo activo hasta: **@fechaExpiracion?.ToString("G")**.
                    </div>
                }
                else
                {
         
                    <form asp-controller="Visitas" asp-action="Reservar" method="post">
                        <input type="hidden" name="inmuebleId" value="@Model.Id" />
                        <button type="submit" class="btn btn-danger btn-lg w-100" asp-antiforgery="true">
                            Reservar ahora (Bloqueo 48h)
                        </button>
                    </form>
                }
            }
            else
            {
        
                <p class="text-danger mt-3 text-center">Debes <a asp-area="Identity" asp-page="/Account/Login">iniciar sesión</a> para agendar visitas o reservar[cite: 45].</p>
            }

        </div>
    </div>
</div>

<div class="mt-5">
    <a asp-action="Catalogo" class="btn btn-secondary">← Volver al Catálogo</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}