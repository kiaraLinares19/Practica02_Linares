@using Microsoft.AspNetCore.Http
@using Practica2.Extensions 
@using System.Text.Json.Nodes 

@* P4: Recuperar el último inmueble de la sesión *@
@{
    int? ultimoInmuebleId = null;
    string titulo = null;
    
    var jsonString = Context.Session.GetString("UltimoInmueble");
    if (jsonString != null)
    {
        try
        {
            var node = JsonNode.Parse(jsonString);
            titulo = node?["Titulo"]?.GetValue<string>();
            ultimoInmuebleId = node?["Id"]?.GetValue<int>();
        }
        catch { /* Ignorar errores de JSON para evitar que se caiga la aplicación */ }
    }
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Practica2</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Practica2.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                
                @* El logo principal *@
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">Practica2</a>
                
                @* P4: Atajo Volver a {Titulo} *@
                @if (ultimoInmuebleId.HasValue && !string.IsNullOrEmpty(titulo))
                {
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item">
                            <a class="nav-link text-danger fw-bold" asp-area="" asp-controller="Inmuebles" asp-action="Detalle" asp-route-id="@ultimoInmuebleId">
                                Volver a: @titulo
                            </a>
                        </li>
                    </ul>
                }
                
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Inmuebles" asp-action="Catalogo">Catálogo</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                        </li>
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2025 - Practica2 - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>